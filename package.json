{
  "name": "kernic",
  "version": "0.1.3",
  "description": "Kern your whole app — design systems from the terminal. Palette picker, Google Fonts, vibes; free forever CLI, export CSS vars / Tailwind v4 / JSON tokens.",
  "type": "module",
  "bin": {
    "kernic": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "studio",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/intentionaut/kernic.git"
  },
  "homepage": "https://intentionaut.com/projects/",
  "bugs": "https://github.com/intentionaut/kernic/issues",
  "author": {
    "name": "Saielle DaSilva",
    "url": "https://intentionaut.com/projects/"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "prepack": "npm run build",
    "test": "npm run build && node dist/index.js list"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "kernic",
    "design-system",
    "design-tokens",
    "cli",
    "tailwind",
    "tailwindcss",
    "css",
    "google-fonts",
    "palette",
    "vibe-coding",
    "w3c-design-tokens"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^0.11.0",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
