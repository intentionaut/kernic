"/* kernic — "acme-tech" Tailwind v4 theme (vibe: tech) */
@import "tailwindcss";
@import url("https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&display=swap");
@import url("https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap");
@import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700&display=swap");

@custom-variant dark (&:where(.dark, .dark *));

:root {
  --background: #eff9f9;
  --surface: #e2eeee;
  --foreground: #0d1616;
  --muted-foreground: #5b6d6e;
  --border-default: #cddadb;
  --ring: #0094a8;
  --primary: var(--color-primary-600);
  --primary-hover: var(--color-primary-500);
  --accent: var(--color-accent-500);
  --elevation-xs: 0px 1px 2px 0px #0d161614;
  --elevation-sm: 0px 1px 3px 0px #0d16161a, 0px 1px 2px -1px #0d16161a;
  --elevation-md: 0px 4px 6px -1px #0d16161a, 0px 2px 4px -2px #0d16161a;
  --elevation-lg: 0px 10px 15px -3px #0d16161a, 0px 4px 6px -4px #0d16161a;
  --elevation-xl: 0px 20px 25px -5px #0d16161a, 0px 8px 10px -6px #0d16161a;
}

.dark {
  --background: #0d1616;
  --surface: #1e2929;
  --foreground: #eff9f9;
  --muted-foreground: #94a5a6;
  --border-default: #303d3e;
  --ring: #0094a8;
  --primary: var(--color-primary-600);
  --primary-hover: var(--color-primary-500);
  --accent: var(--color-accent-500);
  --elevation-xs: 0px 1px 2px 0px #0d161666;
  --elevation-sm: 0px 1px 3px 0px #0d161673, 0px 1px 2px -1px #0d161673;
  --elevation-md: 0px 4px 6px -1px #0d161680, 0px 2px 4px -2px #0d161680;
  --elevation-lg: 0px 10px 15px -3px #0d16168c, 0px 4px 6px -4px #0d16168c;
  --elevation-xl: 0px 20px 25px -5px #0d161699, 0px 8px 10px -6px #0d161699;
}

@theme inline {
  --color-background: var(--background);
  --color-surface: var(--surface);
  --color-foreground: var(--foreground);
  --color-muted: var(--muted-foreground);
  --color-border-default: var(--border-default);
  --color-ring: var(--ring);
  --color-primary: var(--primary);
  --color-primary-hover: var(--primary-hover);
  --color-accent: var(--accent);
  --shadow-xs: var(--elevation-xs);
  --shadow-sm: var(--elevation-sm);
  --shadow-md: var(--elevation-md);
  --shadow-lg: var(--elevation-lg);
  --shadow-xl: var(--elevation-xl);
}

@theme {
  --color-primary-50: #e8fbff;
  --color-primary-100: #c5f5ff;
  --color-primary-200: #a1e4f2;
